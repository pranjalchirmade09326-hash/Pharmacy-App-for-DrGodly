{
  "name": "drgodly-pharmacy-assist-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "DrGodly Pharmacy Assist - Clinical Intake, Doctor Teleconsultation & Pharmacy Care Navigation Monorepo",
  "workspaces": [
    "frontend/web",
    "frontend/mobile",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend/web run dev",
    "dev:web": "npm --prefix frontend/web run dev",
    "dev:mobile": "npm --prefix frontend/mobile start",
    "build": "npm --prefix frontend/web run build",
    "build:web": "npm --prefix frontend/web run build",
    "build:backend": "npm --prefix backend run build",
    "start": "npm --prefix frontend/web start",
    "type-check": "npm --prefix frontend/web run type-check && npm --prefix backend run type-check",
    "type-check:web": "npm --prefix frontend/web run type-check",
    "type-check:mobile": "npm --prefix frontend/mobile run type-check",
    "type-check:backend": "npm --prefix backend run type-check"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
