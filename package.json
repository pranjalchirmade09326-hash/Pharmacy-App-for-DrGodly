{
  "name": "drgodly-pharmacy-assist-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "DrGodly Pharmacy Assist - React Native Mobile App & Backend Clinical Services Monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm --prefix frontend start",
    "dev:mobile": "npm --prefix frontend start",
    "android": "npm --prefix frontend run android",
    "ios": "npm --prefix frontend run ios",
    "build:backend": "npm --prefix backend run build",
    "type-check": "npm --prefix backend run type-check",
    "type-check:frontend": "npm --prefix frontend run type-check",
    "type-check:backend": "npm --prefix backend run type-check"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
