{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CheckoutOrder",
  "type": "object",
  "required": [
    "orderId",
    "pharmacyStoreId",
    "patientDetails",
    "cartItems",
    "subtotalINR",
    "cgstINR",
    "sgstINR",
    "totalAmountINR",
    "status"
  ],
  "properties": {
    "orderId": { "type": "string" },
    "pharmacyStoreId": { "type": "string" },
    "patientDetails": {
      "type": "object",
      "required": ["name", "phone", "age", "gender", "pickupMode"],
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string", "pattern": "^\\+91[6-9]\\d{9}$" },
        "age": { "type": "integer", "minimum": 0 },
        "gender": { "type": "string", "enum": ["MALE", "FEMALE", "OTHER"] },
        "deliveryAddress": { "type": "string" },
        "pickupMode": { "type": "string", "enum": ["STORE_PICKUP", "HOME_DELIVERY"] }
      }
    },
    "cartItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["productId", "brandName", "unitPriceINR", "quantity", "prescriptionRequired"],
        "properties": {
          "productId": { "type": "string" },
          "brandName": { "type": "string" },
          "unitPriceINR": { "type": "number" },
          "quantity": { "type": "integer", "minimum": 1 },
          "prescriptionRequired": { "type": "boolean" }
        }
      }
    },
    "subtotalINR": { "type": "number" },
    "cgstINR": { "type": "number" },
    "sgstINR": { "type": "number" },
    "totalAmountINR": { "type": "number" },
    "prescriptionUploaded": { "type": "boolean" },
    "prescriptionUrl": { "type": "string" },
    "telemedicineReferralId": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["PENDING_VERIFICATION", "READY_FOR_PICKUP", "DISPATCHED", "COMPLETED", "CANCELLED"]
    }
  }
}
